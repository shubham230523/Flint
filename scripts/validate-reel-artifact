#!/usr/bin/env bash

set -eo pipefail

# ============================================================
# Flint — Reel Media Artifact Validator
# ============================================================
#
# Inspects and validates a generated Reel MP4 video file.
# Verifies file existence, decodability, streams, duration,
# aspect ratio (9:16 vertical), and audio/video presence.
# ============================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_FILE="${1:-}"

if [[ -z "$TARGET_FILE" ]]; then
    # Search for latest rendered reel in default paths
    POSSIBLE_FILES=(
        "C:/tmp/flint_media/reels/job_prod_local_1_final_reel.mp4"
        "$ROOT_DIR/build/reels/final_reel.mp4"
    )

    for f in "${POSSIBLE_FILES[@]}"; do
        if [[ -f "$f" ]]; then
            TARGET_FILE="$f"
            break
        fi
    done

    # Fallback to finding any mp4 in C:/tmp/flint_media/reels
    if [[ -z "$TARGET_FILE" ]] && [[ -d "C:/tmp/flint_media/reels" ]]; then
        TARGET_FILE="$(find "C:/tmp/flint_media/reels" -name "*.mp4" -type f | head -n 1 || true)"
    fi
fi

if [[ -z "$TARGET_FILE" ]] || [[ ! -f "$TARGET_FILE" ]]; then
    echo "FAIL: No generated Reel MP4 file found to validate."
    echo "Expected target path or file in C:/tmp/flint_media/reels/"
    exit 1
fi

echo "Validating Reel Artifact: $TARGET_FILE"

# 1. File existence & size
FILE_SIZE=$(wc -c < "$TARGET_FILE" | tr -d ' ')
if [[ "$FILE_SIZE" -lt 1000 ]]; then
    echo "FAIL: File size is too small ($FILE_SIZE bytes)."
    exit 1
fi
echo "[OK] File exists and size is valid: $FILE_SIZE bytes"

# 2. FFprobe inspection
FFPROBE_OUT=$(ffprobe -v error -show_entries format=duration,format_name:stream=codec_type,width,height,r_frame_rate -of default=noprint_wrappers=1 "$TARGET_FILE")

echo "$FFPROBE_OUT"

# 3. Stream & Format Verification using Python
PYTHON_CMD=""
if command -v python >/dev/null 2>&1; then
    PYTHON_CMD="python"
elif command -v py >/dev/null 2>&1; then
    PYTHON_CMD="py"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_CMD="python3"
fi

if [[ -z "$PYTHON_CMD" ]]; then
    echo "FAIL: Python is required for metadata validation."
    exit 1
fi

"$PYTHON_CMD" - "$TARGET_FILE" <<'PY'
import sys
import subprocess
import json

target_file = sys.argv[1]

cmd = [
    "ffprobe",
    "-v", "error",
    "-print_format", "json",
    "-show_format",
    "-show_streams",
    target_file
]

res = subprocess.run(cmd, capture_output=True, text=True)
if res.returncode != 0:
    print(f"FAIL: ffprobe returned error code {res.returncode}: {res.stderr}")
    sys.exit(1)

data = json.loads(res.stdout)

streams = data.get("streams", [])
format_info = data.get("format", {})

video_streams = [s for s in streams if s.get("codec_type") == "video"]
audio_streams = [s for s in streams if s.get("codec_type") == "audio"]

if not video_streams:
    print("FAIL: No video stream found in MP4 artifact.")
    sys.exit(1)

v_stream = video_streams[0]
width = int(v_stream.get("width", 0))
height = int(v_stream.get("height", 0))

print(f"Video Dimensions: {width}x{height}")

if width <= 0 or height <= 0:
    print(f"FAIL: Invalid video resolution: {width}x{height}")
    sys.exit(1)

# Aspect ratio check: Vertical 9:16 requires height > width
if height <= width:
    print(f"FAIL: Video is not vertical 9:16 (width={width}, height={height}). Aspect ratio must be vertical.")
    sys.exit(1)

duration = float(format_info.get("duration", 0.0))
print(f"Video Duration: {duration:.2f}s")

if duration < 1.0:
    print(f"FAIL: Duration unexpectedly short: {duration:.2f}s")
    sys.exit(1)

print("[OK] Reel artifact passed all FFprobe validation checks!")
PY

echo "PASS: Generated Reel artifact validation completed successfully!"
